        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  ...$('Prepare prompt').first().json.request,\n  input: [\n    ...$('Prepare prompt').first().json.request.input,\n    $('Find catalog call').first().json.call,\n    { type: 'function_call_output', call_id: $('Find catalog call').first().json.call.call_id,\n      output: JSON.stringify(Array.isArray($json.items) ? $json.items.slice(0, 5).map(p => ({\n        sku: p.sku, name: p.name, category: p.category,\n        description: p.description?.slice(0, 500), price_minor: p.price_minor,\n      })) : []) },\n  ],\n  tool_choice: 'none',\n}) }}",
        "options": {
