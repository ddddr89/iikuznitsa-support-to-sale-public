              "id": "fd64459f-f264-4bdb-9b08-f0ddb503834a",
              "leftValue": "={{ $json.query.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
