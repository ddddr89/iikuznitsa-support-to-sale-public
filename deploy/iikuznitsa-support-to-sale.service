[Unit]
Description=IIKuznitsa Support-to-Sale API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=demon
Group=demon
WorkingDirectory=/home/demon/projects/iikuznitsa-support-to-sale
ExecStart=/bin/bash deploy/serve-stand.sh 18443
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
